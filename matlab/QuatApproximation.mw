% QuatApproximation.mw
% mwrap interface for harmonic_mod (and future qkernel_mod, omega_mod).
%
% Build flags: mwrap -c99complex -i8 -mex
% After generation: perl -pi -e 's/_{2,}/_/g' QuatApproximation_mex.c
%
% Per the design spec §9 universal-prefix rule, every top-level Fortran
% mex wrapper carries the qa<m>_ prefix:
%   qah_*  = harmonic_mod
%   qak_*  = qkernel_mod   (not yet ported)
%   qao_*  = omega_mod     (not yet ported)
%
% ============================================================
% mwrap syntax reminder:
%
%   @function [inout1, inout2] = SubroutineName_mex(in1, in2, inout1, inout2)
%   % optional MATLAB pre-processing (reshape, complex coercion, nargin defaults)
%   # FORTRAN SubroutineName(type[dims] in1, type[dims] in2, inout type[dims] inout1, inout type[dims] inout2);
%   end
%
% Conventions:
% - inout variables appear on BOTH sides of the MATLAB call.
% - type keywords: int, double, dcomplex
% - dims: [1] scalar, [n] vector, [3,n] 2D array (col-major).
%   mwrap only supports 1D/2D shapes; higher-rank Fortran arrays are
%   passed flattened and remapped via c_f_pointer inside the *_mex.f90.
% - Derived size variables (e.g. nc = (nterms+1)*(nterms+1)) are computed
%   in the MATLAB-side block before the `# FORTRAN` line.
%
% ============================================================
% koorn_geom_mod wrappers (qakg_*)
% Vendored verbatim from LineQuaaadrature-legacy/matlab/LineQuaaadrature.mw
% with lqkg_* -> qakg_* on the top-level wrapper names. Module-internal
% procedure names inside koorn_geom_mod stay as the original (some carry
% a legacy lqkg_ prefix, kept per "if they are the same, they are the same").
% ============================================================

% --------------------------------------------------------------------------
@function [R, c, alpha] = qakg_circumcircle_transform_3d_mex(r_vert, R, c, alpha)
r_vert = double(reshape(r_vert, 3, 3));
R = double(reshape(R, 3, 3));
c = double(c(:));
alpha = double(alpha);
# FORTRAN qakg_circumcircle_transform_3d_mex(double[3,3] r_vert, inout double[3,3] R, inout double[3] c, inout double[1] alpha);
end

@function [R, c, alpha] = qakg_circumcircle_transform_3d_r128_mex(r_vert, R, c, alpha, ktri, flag)
r_vert = double(reshape(r_vert, 3, 3));
if nargin < 2 || isempty(R),     R     = zeros(3, 3); end
if nargin < 3 || isempty(c),     c     = zeros(3, 1); end
if nargin < 4 || isempty(alpha), alpha = 0;           end
if nargin < 5 || isempty(ktri),  ktri  = 0;           end
if nargin < 6 || isempty(flag),  flag  = 0;           end
R     = double(reshape(R, 3, 3));
c     = double(c(:));
alpha = double(alpha);
ktri  = double(ktri);
flag  = double(flag);
# FORTRAN qakg_circumcircle_transform_3d_r128_mex(double[3,3] r_vert, inout double[3,3] R, inout double[3] c, inout double[1] alpha, int[1] ktri, int[1] flag);
end

@function [R, c, alpha, sxbd, sxpbd, stangbd, sspbd, txnew, snxnew, qhat, kdata] = qakg_setup_target_r128_mex(m, n, nbd, sbdnp, nquad, r_vert, tx, snx, sxbd_in, Dgl, R, c, alpha, sxbd, sxpbd, stangbd, sspbd, txnew, snxnew, qhat, kdata, ktri, flag)
m     = double(m);
n     = double(n);
nbd   = double(nbd);
sbdnp = double(sbdnp);
nquad = double(nquad);
r_vert  = double(reshape(r_vert,  3, 3));
tx      = double(reshape(tx,      3, m));
snx     = double(reshape(snx,     3, n));
sxbd_in = double(reshape(sxbd_in, 3, nbd));
Dgl     = double(reshape(Dgl,     nquad, nquad));
if nargin < 11 || isempty(R),       R       = zeros(3, 3);   end
if nargin < 12 || isempty(c),       c       = zeros(3, 1);   end
if nargin < 13 || isempty(alpha),   alpha   = 0;             end
if nargin < 14 || isempty(sxbd),    sxbd    = zeros(3, nbd); end
if nargin < 15 || isempty(sxpbd),   sxpbd   = zeros(3, nbd); end
if nargin < 16 || isempty(stangbd), stangbd = zeros(3, nbd); end
if nargin < 17 || isempty(sspbd),   sspbd   = zeros(nbd, 1); end
if nargin < 18 || isempty(txnew),   txnew   = zeros(3, m);   end
if nargin < 19 || isempty(snxnew),  snxnew  = zeros(3, n);   end
if nargin < 20 || isempty(qhat),    qhat    = zeros(3, 1);   end
if nargin < 21 || isempty(kdata),   kdata   = zeros(3, m);   end
if nargin < 22 || isempty(ktri),    ktri    = 0;             end
if nargin < 23 || isempty(flag),    flag    = 0;             end
R       = double(reshape(R,       3, 3));
c       = double(c(:));
alpha   = double(alpha);
sxbd    = double(reshape(sxbd,    3, nbd));
sxpbd   = double(reshape(sxpbd,   3, nbd));
stangbd = double(reshape(stangbd, 3, nbd));
sspbd   = double(sspbd(:));
txnew   = double(reshape(txnew,   3, m));
snxnew  = double(reshape(snxnew,  3, n));
qhat    = double(qhat(:));
kdata   = double(reshape(kdata,   3, m));
ktri    = double(ktri);
flag    = double(flag);
# FORTRAN qakg_setup_target_r128_mex(int[1] m, int[1] n, int[1] nbd, int[1] sbdnp, int[1] nquad, double[3,3] r_vert, double[3,m] tx, double[3,n] snx, double[3,nbd] sxbd_in, double[nquad,nquad] Dgl, inout double[3,3] R, inout double[3] c, inout double[1] alpha, inout double[3,nbd] sxbd, inout double[3,nbd] sxpbd, inout double[3,nbd] stangbd, inout double[nbd] sspbd, inout double[3,m] txnew, inout double[3,n] snxnew, inout double[3] qhat, inout double[3,m] kdata, int[1] ktri, int[1] flag);
end

% --------------------------------------------------------------------------
@function [uvs] = qakg_get_vioreanu_nodes_mex(norder, npols, uvs)
% Vioreanu-Rokhlin reference-triangle nodes of order norder
% (npols = (norder+1)*(norder+2)/2 columns).
norder = double(norder);
npols  = double(npols);
if nargin < 3 || isempty(uvs), uvs = zeros(2, npols); end
uvs = double(reshape(uvs, 2, npols));
# FORTRAN qakg_get_vioreanu_nodes_mex(int[1] norder, int[1] npols, inout double[2,npols] uvs);
end

% --------------------------------------------------------------------------
@function [wts] = qakg_get_vioreanu_wts_mex(norder, npols, wts)
% Vioreanu-Rokhlin reference-triangle quadrature weights of order norder.
norder = double(norder);
npols  = double(npols);
if nargin < 3 || isempty(wts), wts = zeros(npols, 1); end
wts = double(wts(:));
# FORTRAN qakg_get_vioreanu_wts_mex(int[1] norder, int[1] npols, inout double[npols] wts);
end

% --------------------------------------------------------------------------
@function [umatr, vmatr] = qakg_koorn_vals2coefs_coefs2vals_mex(korder, kpols, umatr, vmatr)
% Koornwinder vals<->coefs matrices at the VR nodes of order korder.
korder = double(korder);
kpols  = double(kpols);
if nargin < 3 || isempty(umatr), umatr = zeros(kpols, kpols); end
if nargin < 4 || isempty(vmatr), vmatr = zeros(kpols, kpols); end
umatr = double(reshape(umatr, kpols, kpols));
vmatr = double(reshape(vmatr, kpols, kpols));
# FORTRAN qakg_koorn_vals2coefs_coefs2vals_mex(int[1] korder, int[1] kpols, inout double[kpols,kpols] umatr, inout double[kpols,kpols] vmatr);
end

% --------------------------------------------------------------------------
@function [sxbd, swbd, stangbd, sspbd, r_vert] = qakg_line3quadr_3dline_mex(x_uvs, korder, kpols, umatr, nquad, tgl, wgl, Dgl, sbdnp, tpan, nbd, sxbd, swbd, stangbd, sspbd, r_vert)
% GL boundary quadrature (nodes/weights/tangents/speeds) along the three
% edges of a curved triangle described by Koornwinder coeffs.
korder = double(korder);
kpols  = double(kpols);
nquad  = double(nquad);
sbdnp    = double(sbdnp);
nbd      = double(nbd);
sbdnpp1  = sbdnp + 1;
x_uvs    = double(reshape(x_uvs, 3, kpols));
umatr    = double(reshape(umatr, kpols, kpols));
tgl      = double(tgl(:));
wgl      = double(wgl(:));
Dgl      = double(reshape(Dgl, nquad, nquad));
tpan     = double(tpan(:));
if nargin < 12 || isempty(sxbd),    sxbd    = zeros(3, nbd); end
if nargin < 13 || isempty(swbd),    swbd    = zeros(1, nbd); end
if nargin < 14 || isempty(stangbd), stangbd = zeros(3, nbd); end
if nargin < 15 || isempty(sspbd),   sspbd   = zeros(1, nbd); end
if nargin < 16 || isempty(r_vert),  r_vert  = zeros(3, 3);   end
sxbd    = double(reshape(sxbd,    3, nbd));
swbd    = double(swbd(:)');
stangbd = double(reshape(stangbd, 3, nbd));
sspbd   = double(sspbd(:)');
r_vert  = double(reshape(r_vert, 3, 3));
# FORTRAN qakg_line3quadr_3dline_mex(double[3,kpols] x_uvs, int[1] korder, int[1] kpols, double[kpols,kpols] umatr, int[1] nquad, double[nquad] tgl, double[nquad] wgl, double[nquad,nquad] Dgl, int[1] sbdnp, double[sbdnpp1] tpan, int[1] nbd, inout double[3,nbd] sxbd, inout double[nbd] swbd, inout double[3,nbd] stangbd, inout double[nbd] sspbd, inout double[3,3] r_vert);
end

